version: '3.8'

networks:
  monitoring:
    driver: bridge

services:
  nginx-proxy:
    image: nginxproxy/nginx-proxy:latest
    container_name: nginx-proxy
    networks:
      - monitoring
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/tmp/docker.sock:ro
      - /opt/monitoring/nginx/certs:/etc/nginx/certs
      - /opt/monitoring/nginx/vhost.d:/etc/nginx/vhost.d
      - /opt/monitoring/nginx/html:/usr/share/nginx/html
    labels:
      - "com.github.jrcs.letsencrypt_nginx_proxy_companion.nginx_proxy"
    restart: unless-stopped

  nginx-proxy-acme:
    image: nginxproxy/acme-companion:latest
    container_name: nginx-proxy-acme
    networks:
      - monitoring
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/monitoring/nginx/certs:/etc/nginx/certs
      - /opt/monitoring/nginx/vhost.d:/etc/nginx/vhost.d
      - /opt/monitoring/nginx/html:/usr/share/nginx/html
      - /opt/monitoring/nginx/acme:/etc/acme.sh
    environment:
      - DEFAULT_EMAIL={{ letsencrypt_email | default('') }}
    depends_on:
      - nginx-proxy
    restart: unless-stopped

  prometheus:
    image: prom/prometheus:v2.48.1
    container_name: prometheus
    networks:
      - monitoring
    volumes:
      - /opt/monitoring/prometheus:/prometheus
      - /opt/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=15d'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
      - '--web.enable-remote-write-receiver'
    ports:
      - "9090:9090"
    restart: unless-stopped

  loki:
    image: grafana/loki:2.9.4
    container_name: loki
    networks:
      - monitoring
    volumes:
      - /opt/monitoring/loki:/loki
      - /opt/monitoring/loki-config.yml:/etc/loki/local-config.yaml
    environment:
      - S3_ID={{ vault_s3_access_key }}
      - S3_KEY={{ vault_s3_secret_key }}
    ports:
      - "3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    restart: unless-stopped

  grafana:
    image: grafana/grafana:10.2.3
    container_name: grafana
    networks:
      - monitoring
    environment:
      - GF_SECURITY_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
      - GF_PATHS_PROVISIONING=/etc/grafana/provisioning
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_AUTH_DISABLE_LOGIN_FORM=false
      - GF_USERS_AUTO_ASSIGN_ORG=true
      - GF_USERS_AUTO_ASSIGN_ORG_ID=1
      - GF_USERS_AUTO_ASSIGN_ORG_ROLE=Viewer
      - VIRTUAL_HOST={{ grafana_domain | default('monitoring.kw4jlb.com') }}
      - LETSENCRYPT_HOST={{ grafana_domain | default('monitoring.kw4jlb.com') }}
      - LETSENCRYPT_EMAIL={{ letsencrypt_email | default('admin@example.com') }}
    volumes:
      - /opt/monitoring/grafana:/var/lib/grafana
      - /opt/monitoring/grafana/provisioning:/etc/grafana/provisioning
    expose:
      - "3000"
    restart: unless-stopped
    depends_on:
      - prometheus
      - loki
      - nginx-proxy