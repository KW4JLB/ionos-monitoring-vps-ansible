              "device": true,
              "fstype": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Used %",
              "mountpoint": "Filesystem"
            }
          }
        }
      ],
      "type": "table"
