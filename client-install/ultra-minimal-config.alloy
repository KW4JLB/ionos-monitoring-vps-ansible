// Ultra-minimal Alloy config for Pi 3B+ - Emergency Performance Fix
logging {
  level  = "debug"
  format = "logfmt"
}

// Prometheus remote write with minimal WAL usage
prometheus.remote_write "monitoring_server" {
  endpoint {
    url = "http://monitoring.kw4jlb.com:9090/api/v1/write"
    
    queue_config {
      max_shards = 1
      max_samples_per_send = 50
      batch_send_deadline = "30s"
    }
  }
  
  // Minimal WAL settings
  wal {
    truncate_frequency = "1h"
    min_keepalive_time = "30s"
    max_keepalive_time = "5m"
  }
  
  external_labels = {
    instance = "node592420",
    service  = "asterisk",
  }
}

// Only collect essential Allstar metrics
prometheus.scrape "allstar_minimal" {
  targets = [{
    __address__ = "127.0.0.1:8089",
    instance    = "node592420",
  }]
  
  forward_to      = [prometheus.remote_write.monitoring_server.receiver]
  scrape_interval = "2m"
  scrape_timeout  = "30s"
  metrics_path    = "/metrics"
}

// Basic system metrics for Enhanced System Health dashboard
prometheus.exporter.unix "system" {
  include_exporter_metrics = false
  disable_collectors = [
    "mdadm", "wifi", "powersupplyclass", "dmi", "thermal_zone", 
    "cooling_device", "processes", "interrupts",
  ]
  
  // Enable essential collectors for system health dashboard
  enable_collectors = ["netdev", "netstat", "filesystem", "diskstats", "hwmon"]
}

prometheus.scrape "system_metrics" {
  targets         = prometheus.exporter.unix.system.targets
  forward_to      = [prometheus.remote_write.monitoring_server.receiver]
  job_name        = "node-exporter"
  scrape_interval = "30s"  // More frequent for CPU rate calculations
}